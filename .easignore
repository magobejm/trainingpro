# EAS Build ignore — when present, this REPLACES .gitignore for the build tarball.
# Mirror .gitignore here, plus exclude .env.local files (EAS includes .env* by
# default even when gitignored, which would bake localhost dev URLs into builds).

node_modules
.pnpm-store
.cursor
.playwright-cli
capturas-candados
output
logs
.worktrees
docs
/plans/
.claude/*
tmp/*

# Env files — keep .env.example, exclude everything else (esp. .env.local with
# localhost dev values that must NOT be bundled into EAS builds)
.env
.env.*
!.env.example

# Service account keys (must NEVER be committed)
*-sa-key.json
firebase-sa-key.json
gcp-*-key.json

# Build artifacts
apps/**/dist/
build/
coverage/

# Runtime logs/temp
*.log
**/.run/
apps/api/prisma/.tmp-seed/
prisma/_tmp*

# Local app state. android/ and ios/ are generated on the build server.
apps/mobile/.expo/
apps/mobile/android/
apps/mobile/ios/

# Supabase local temp state
supabase/.temp/
supabase/.branches/
supabase/snippets/

# Local binaries
schema-engine-*.exe
