NODE_ENV=development
PORT=8080

# Database — desarrollo local usa Supabase CLI (pnpm dlx supabase start).
# El docker-compose Postgres del repo (puerto 5432) es SOLO para CI.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/postgres?sslmode=disable
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:55432/postgres?sslmode=disable

# Supabase local (Auth + Storage del Supabase CLI)
SUPABASE_URL=http://127.0.0.1:55421
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU
SUPABASE_STORAGE_BUCKET=trainerpro-dev
# Bucket privado para avatares, fotos de progreso y adjuntos de chat. No puede ser público.
SUPABASE_PRIVATE_STORAGE_BUCKET=trainerpro-dev-private
# Obligatorio en producción cuando Supabase está configurado. Rotarlo invalida las URLs ya emitidas.
MEDIA_URL_SIGNING_SECRET=change-me
# Caducidad de las URLs firmadas, en segundos. Por defecto 3600.
PRIVATE_MEDIA_URL_TTL_SECONDS=3600

# AI Integration
GEMINI_API_KEY=tu-api-key-de-gemini-aqui
