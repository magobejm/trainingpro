{
  "expo": {
    "name": "Trainer Pro Mobile",
    "slug": "trainer-pro-mobile",
    "scheme": "trainerpro",
    "version": "1.3.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "platforms": ["ios", "android", "web"],
    "android": {
      "package": "com.trainerpro.mobile",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "SCHEDULE_EXACT_ALARM",
        "VIBRATE",
        "POST_NOTIFICATIONS",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_HEART_RATE"
      ],
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2563eb"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "backgroundColor": "#07000f"
    },
    "backgroundColor": "#07000f",
    "extra": {
      "eas": {
        "projectId": "e32025fc-78da-4dfc-89d8-60149b6e193d"
      }
    },
    "owner": "magobejm",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e32025fc-78da-4dfc-89d8-60149b6e193d"
    },
    "ios": {},
    "plugins": [
      ["expo-build-properties", { "android": { "minSdkVersion": 26 } }],
      "expo-secure-store",
      [
        "react-native-health-connect",
        {
          "permissions": [
            "android.permission.health.READ_STEPS",
            "android.permission.health.READ_SLEEP",
            "android.permission.health.READ_WEIGHT",
            "android.permission.health.READ_HEART_RATE"
          ]
        }
      ],
      "expo-document-picker",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Trainer Pro usa la cámara para fotografiar tus comidas y grabar tus series.",
          "microphonePermission": "Trainer Pro usa el micrófono al grabar vídeos de tus series.",
          "photosPermission": "Trainer Pro accede a tus fotos para adjuntarlas."
        }
      ],
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "Trainer Pro usa la cámara para tus fotos de progreso.",
          "recordAudioAndroid": false
        }
      ]
    ]
  }
}
