{
  "expo": {
    "name": "Trainer Pro Mobile",
    "slug": "trainer-pro-mobile",
    "scheme": "trainerpro",
    "version": "1.3.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "platforms": ["ios", "android", "web"],
    "android": {
      "package": "com.trainerpro.mobile",
      "permissions": ["CAMERA", "SCHEDULE_EXACT_ALARM", "VIBRATE", "POST_NOTIFICATIONS"],
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2563eb"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "backgroundColor": "#07000f"
    },
    "backgroundColor": "#07000f",
    "extra": {
      "eas": {
        "projectId": "e32025fc-78da-4dfc-89d8-60149b6e193d"
      }
    },
    "owner": "magobejm",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e32025fc-78da-4dfc-89d8-60149b6e193d"
    },
    "ios": {},
    "plugins": [
      "expo-secure-store",
      "expo-document-picker",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "Trainer Pro usa la cámara para tus fotos de progreso.",
          "recordAudioAndroid": false
        }
      ]
    ]
  }
}
